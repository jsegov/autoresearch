CORE_OFI_HOST=127.0.0.1
CORE_OFI_PORT=5561
CROSS_OFI_HOST=127.0.0.1
CROSS_OFI_PORT=5562
ENABLE_CORE_STREAM=false
ENABLE_CROSS_STREAM=true

SIGNAL_EMIT_INTERVAL_SECONDS=1.0
SIGNAL_STALE_SECONDS=2.0
MAX_SPREAD_ES=1.0
MAX_SPREAD_NQ=2.0
CALIBRATION_FILE=data/signal_calibration.json
MODEL_FILE=data/signal_models.json

DATA_DIR=data
FEATURE_LOG_FILE=data/cross_market_features.jsonl
SIGNAL_LOG_FILE=data/es_nq_direction_signals.jsonl

DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_STATUSES=post,high_priority
DISCORD_WEBHOOK_MIN_CONFIDENCE=0.0
DISCORD_WEBHOOK_COOLDOWN_SECONDS=45
DISCORD_WEBHOOK_TIMEOUT_SECONDS=5

SIDE_GUARD_ENABLED=true
SIDE_GUARD_LOOKBACK_TRADES=80
SIDE_GUARD_MIN_SAMPLES=25
SIDE_GUARD_MIN_WIN_RATE=0.53
SIDE_GUARD_APPLY_STATUSES=post,high_priority

RTH_ONLY_ENABLED=true
RTH_START_ET=09:30
RTH_END_ET=16:00

# Research-backed quality gates: downgrade post/high_priority to watch when failed.
SHADOW_QUALITY_GATE_ENABLED=true
SHADOW_QUALITY_GATE_APPLY_STATUSES=post,high_priority

# RTH K-means best-cluster gate (ES/NQ 5m/10m). Models from export_live_cluster_models.py.
# NQ_5m uses research cluster 0 (~62% directional hit, n~58 on full-session labeled sample).
LIVE_CLUSTER_GATE_ENABLED=true
LIVE_CLUSTER_GATE_APPLY_STATUSES=post,high_priority
LIVE_CLUSTER_MODELS_FILE=data/live_cluster_models_2026-06-14.json

# Cross-market anomaly overlay (separate alert lane; does not change post/high_priority gates).
ANOMALY_OVERLAY_ENABLED=true
ANOMALY_OVERLAY_LOG_FILE=data/cross_market_anomaly_overlay.jsonl
ANOMALY_OVERLAY_ALERT_ENABLED=false
ANOMALY_OVERLAY_DISCORD_WEBHOOK_URL=
ANOMALY_OVERLAY_DISCORD_COOLDOWN_SECONDS=120
# Shared cache written by trading-events-v2 (GEXBOT_CONTEXT_CACHE_FILE).
GEXBOT_CONTEXT_CACHE_FILE=../updated-discord-bots/apps/trading-events-v2/data/gexbot_context_cache.json
