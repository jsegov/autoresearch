CORE_OFI_HOST=127.0.0.1
CORE_OFI_PORT=5561
CROSS_OFI_HOST=127.0.0.1
CROSS_OFI_PORT=5563
ENABLE_CORE_STREAM=false
ENABLE_CROSS_STREAM=true

SIGNAL_EMIT_INTERVAL_SECONDS=1.0
SIGNAL_STALE_SECONDS=2.0
ENABLED_TARGET_MARKETS=ES,NQ,CL,UB
MAX_SPREAD_ES=1.0
MAX_SPREAD_NQ=2.0
MAX_SPREAD_CL=0.05
MAX_SPREAD_UB=0.0625
CALIBRATION_FILE=data/signal_calibration.json
MODEL_FILE=data/signal_models.json

DATA_DIR=data
FEATURE_LOG_FILE=data/cross_market_features.jsonl
SIGNAL_LOG_FILE=data/es_nq_direction_signals.jsonl

DISCORD_WEBHOOK_ENABLED=false
# Comma/semicolon-separated list posts the same alert to every webhook.
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_STATUSES=post,high_priority
DISCORD_WEBHOOK_MIN_CONFIDENCE=0.0
DISCORD_WEBHOOK_COOLDOWN_SECONDS=45
DISCORD_WEBHOOK_TIMEOUT_SECONDS=5

# CL/UB rules-first lane. All promotion and posting controls fail closed.
# After the chartbook smoke test, add CL and/or UB to the validation allowlist.
# Posting still requires its separate per-product switch and webhook.
EXPERIMENTAL_SMOKE_VALIDATED_MARKETS=
EXPERIMENTAL_CL_POSTING_ENABLED=false
EXPERIMENTAL_UB_POSTING_ENABLED=false
EXPERIMENTAL_CL_DISCORD_WEBHOOK_URL=
EXPERIMENTAL_UB_DISCORD_WEBHOOK_URL=
EXPERIMENTAL_DISCORD_COOLDOWN_SECONDS=180

# Native mega-equity rules-first cross-market rows. Collection and every
# posting authorization are off by default. The producer has no stock Discord
# destination; downstream Greybox/Blackbox own their shared lane webhooks.
MEGA_EQUITIES_ENABLED=false
MEGA_EQUITY_MARKETS=AAPL,GOOG,GOOGL,MSFT,META,TSLA,SPCX,NVDA,AMZN
MEGA_EQUITY_POST_MARKETS=
MEGA_EQUITY_SMOKE_VALIDATED_MARKETS=
EQUITY_BREADTH_URL=http://127.0.0.1:8081/api/options/v1/equity-breadth
# Optional; when set, sent only as x-options-proxy-secret to the options API.
EQUITY_BREADTH_PROXY_SECRET=
EQUITY_BREADTH_POLL_SECONDS=1.0
EQUITY_BREADTH_TIMEOUT_SECONDS=1.0
# Optional additional YYYY-MM-DD early closes; common US half-days are
# detected by the service. Equity alert windows are 09:35-15:55 ET regular
# and 09:35-12:55 ET on early-close dates.
MEGA_EQUITY_EARLY_CLOSE_DATES=

SIDE_GUARD_ENABLED=true
SIDE_GUARD_LOOKBACK_TRADES=80
SIDE_GUARD_MIN_SAMPLES=25
SIDE_GUARD_MIN_WIN_RATE=0.53
SIDE_GUARD_APPLY_STATUSES=post,high_priority

RTH_ONLY_ENABLED=true
RTH_START_ET=09:30
RTH_END_ET=16:00
# Stream state and CL/UB research rows continue outside this window. Only
# in-window primary-horizon alerts (CL 5m, UB 10m) can notify or pulse Sierra.

# Research-backed quality gates: downgrade post/high_priority to watch when failed.
SHADOW_QUALITY_GATE_ENABLED=true
SHADOW_QUALITY_GATE_APPLY_STATUSES=post,high_priority

# RTH K-means best-cluster gate (ES/NQ 5m/10m). Models from export_live_cluster_models.py.
# NQ_5m uses research cluster 0 (~62% directional hit, n~58 on full-session labeled sample).
LIVE_CLUSTER_GATE_ENABLED=true
LIVE_CLUSTER_GATE_APPLY_STATUSES=post,high_priority
LIVE_CLUSTER_MODELS_FILE=data/live_cluster_models_2026-06-14.json

# Cross-market anomaly overlay (separate alert lane; does not change post/high_priority gates).
ANOMALY_OVERLAY_ENABLED=true
ANOMALY_OVERLAY_LOG_FILE=data/cross_market_anomaly_overlay.jsonl
ANOMALY_OVERLAY_ALERT_ENABLED=false
ANOMALY_OVERLAY_DISCORD_WEBHOOK_URL=
ANOMALY_OVERLAY_DISCORD_COOLDOWN_SECONDS=120
# Shared cache written by trading-events-v2 (GEXBOT_CONTEXT_CACHE_FILE).
GEXBOT_CONTEXT_CACHE_FILE=../updated-discord-bots/apps/trading-events-v2/data/gexbot_context_cache.json

# Opt-in Sierra pulse file for Prop Alpha Signal Deployer. Writes only after
# a Discord post actually goes out. Leave false until the ACSIL adapter is
# on the chart with Study Enabled / Send Orders off.
SIERRA_ALERT_BRIDGE_ENABLED=false
SIERRA_ALERT_BRIDGE_PATH=C:\SierraChart\Data\external_alert_signals.tsv
